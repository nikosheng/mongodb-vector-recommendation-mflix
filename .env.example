# MongoDB Atlas connection string (sample_mflix database)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/sample_mflix?retryWrites=true&w=majority

# Database name
DB_NAME=sample_mflix

# Voyage AI API key (works with both direct API and Atlas AI gateway)
VOYAGE_API_KEY=your_voyage_api_key_here

# Voyage AI base URL — use Atlas AI gateway (recommended) or direct Voyage API
VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Voyage embedding model
VOYAGE_MODEL=voyage-4

# Embedding dimensionality (voyage-4 default: 1024)
EMBEDDING_DIM=1024

# Rocchio alpha: strength of negative feedback penalty (0.0 - 1.0)
ALPHA=0.4

# Atlas Vector Search index name on sample_mflix.movies
VECTOR_INDEX_NAME=vector_index_voyage4

# Collection that holds movies with plot embeddings
# sample_mflix uses "embedded_movies" (not "movies") for the embedded subset
MOVIES_COLLECTION=embedded_movies

# Field name storing plot embeddings in the movies collection
EMBEDDING_FIELD=plot_embedding_voyage_4

# ── Composite embedding (genre-aware) ───────────────────────────────────
# Field written by: python scripts/generate_composite_embeddings.py
COMPOSITE_EMBEDDING_FIELD=plot_genre_composite_embedding
# Atlas vector index name (create after script runs — see script output for JSON)
COMPOSITE_VECTOR_INDEX=composite_vector_index
# λ: fraction of genre signal in composite embedding
# composite = normalize(λ·embed(genres_str) + (1-λ)·plot_embedding)
# λ=0.35 → Action vs Drama: 0.959 plot-only → 0.819 composite (better genre isolation)
# λ=0.5  → stronger genre separation, less plot nuance
GENRE_BLEND_LAMBDA=0.35

# ── Session mode: real-time accumulation ─────────────────────────────────
# All skip/play events accumulate indefinitely — no time window.
# Events only clear when user clicks ↺ Reset Demo (DELETE user_realtime_sessions doc).
# The 24h document-level TTL is for DB hygiene only, not event pruning.

# Global: total skips of any genre before full Rocchio fires
NEGATIVE_THRESHOLD=3

# Per-genre: skips of the same genre before per-genre Rocchio fires + row rotation
GENRE_SKIP_THRESHOLD=2

# Rocchio positive attraction BASE weight β
# Effective β scales with play count: β_eff = BETA × min(play_count, BETA_MAX_MULTIPLIER)
# 1 play=0.6×1=0.6  3 plays=0.6×3=1.8  5+ plays=0.6×5=3.0
BETA=0.6
BETA_MAX_MULTIPLIER=5

# Plays of the same genre within the window needed to surface a "Because you watched" row
PLAY_ROW_THRESHOLD=2

# Background profile drift rate per play (15% = visible within a demo session)
# After 3 plays: profile is 0.85³ ≈ 61% original + 39% toward played content
DRIFT_RATE=0.15

# Persistent profile rejection when global skip threshold is first crossed.
# Removes this fraction of the skipped direction from user_profiles.user_vector.
# 0.5 = removes 50% of skipped direction; conservative to avoid overcorrection.
# REJECTION_STRENGTH (0.8) is ephemeral per-request; SKIP_DRIFT_RATE (0.5) persists.
SKIP_DRIFT_RATE=0.5

# Trail / row layout
TRAIL_LIMIT=20          # movies in "Recommended For You" row
GENRE_ROWS_COUNT=3      # number of genre rows displayed
GENRE_ROW_LIMIT=12      # movies per genre row
NUM_CANDIDATES=200      # Atlas $vectorSearch numCandidates for RFY row
GENRE_NUM_CANDIDATES=100  # Atlas $vectorSearch numCandidates per genre row

# Admin boost: max positions reserved for boosted movies in the RFY row
MAX_BOOSTED_SLOTS=3
